# Copy this file to .env.local for local development.
# Never commit .env.local, .env, or real secret values.

# App / Auth
# Base URL used by NextAuth callbacks. Use http://localhost:3000 for normal local dev.
NEXTAUTH_URL=http://localhost:3000

# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-generated-secret

# Whether NextAuth should trust the incoming Host header.
# Local dev usually works with false. Docker may need true.
AUTH_TRUST_HOST=false

# Email that should receive admin role during sign-in/seed.
ADMIN_EMAIL=you@yourcompany.com

# Database
# PostgreSQL connection string used by Prisma and pgvector queries.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/enterprise_chat

# Microsoft Entra ID / Azure AD
# OAuth app credentials for Microsoft login.
AZURE_AD_CLIENT_ID=replace-with-azure-client-id
AZURE_AD_CLIENT_SECRET=replace-with-azure-client-secret
AZURE_AD_TENANT_ID=replace-with-azure-tenant-id

# LLM Provider
# Groq API key and chat model used for answer generation.
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings
# Ollama server used for local embedding generation.
OLLAMA_BASE_URL=http://localhost:11434

# Web Crawling
# Firecrawl key used when ingesting website URLs.
FIRECRAWL_API_KEY=replace-with-firecrawl-api-key

# Uploads / Crawl Safety
# Local directory where uploaded documents are stored.
UPLOAD_DIR=./uploads

# Max upload size in bytes. Default shown is 10 MB.
MAX_UPLOAD_FILE_BYTES=10485760

# Comma-separated HTTPS host allowlist for URL ingestion.
ALLOWED_CRAWL_HOSTS=hestabit.com,www.hestabit.com

# Redis / Rate Limiting
# Upstash Redis enables API rate limiting. If empty, rate limiting fails open.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Normal chat rate limit: sustained requests per window.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=3600

# Normal chat burst limit.
RATE_LIMIT_BURST_REQUESTS=5
RATE_LIMIT_BURST_WINDOW_SECONDS=10

# Admin RAG/upload rate limit: sustained requests per window.
ADMIN_RAG_RATE_LIMIT_REQUESTS=10
ADMIN_RAG_RATE_LIMIT_WINDOW_SECONDS=3600

# Admin RAG/upload burst limit.
ADMIN_RAG_RATE_LIMIT_BURST_REQUESTS=2
ADMIN_RAG_RATE_LIMIT_BURST_WINDOW_SECONDS=60
